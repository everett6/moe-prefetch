+// Enqueue uploads for `ids` into layer `li`, spending at most `budget` of the
+// layer's pre-freed slots. Caller holds mc->mtx. Touches no table.
+//
+// `min_keep` is not optional decoration. Predictions for layer L+1 are issued
+// while layer L is observed -- that is the whole point, it buys the copy a
+// layer of slack -- but layer L+1's own demand misses are not known yet and
+// arrive later in the same token. Without a floor the predictor drains the pool
+// first and the demand path, which has ground truth rather than a guess, finds
+// it empty. Measured: that inversion cost 4 tok/s and read exactly like "the
+// predictor does not help".
+int issue_uploads(moe_cache * mc, size_t li, const int32_t * ids, size_t n, int budget,
+                  int min_keep = 0) {
+    layer_state & ls = mc->layers[li];
+    int issued = 0;
+    for (size_t i = 0; i < n && issued < budget; ++i) {
+        const int32_t id = ids[i];
+        if (id < 0 || id >= (int32_t) ls.expert_slot.size()) {
+            continue;
+        }
+        if (ls.expert_slot[id] >= 0) {
+            continue;                       // already resident
+        }
+        if ((int) ls.free_slots.size() <= min_keep) {
+            break;      // reserved for the demand path, or simply nothing spare
+        }
+        bool dup = false;
+        {
+            std::lock_guard<std::mutex> wlk(mc->wmtx);
+            for (const auto & j : mc->todo) {
+                if (j.layer_idx == li && j.expert == id) { dup = true; break; }
+            }
+            if (!dup) {
+                for (const auto & j : mc->done) {
+                    if (j.layer_idx == li && j.expert == id) { dup = true; break; }
+                }
+            }
+            if (dup) {
+                continue;
+            }
+            const int32_t slot = ls.free_slots.back();
+            ls.free_slots.pop_back();
+            ls.slot_in_flight[slot] = true;
+            mc->todo.push_back({li, id, slot});
+            mc->n_uploads++;
+            mc->n_scheduled++;
+        }
+        issued++;
+    }
+    if (issued) {
+        mc->wcv.notify_all();
+    }
+    return issued;
+}
