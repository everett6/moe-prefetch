+struct ggml_tensor * ggml_moe_rows(
+        struct ggml_context * ctx,
+        struct ggml_tensor * up, struct ggml_tensor * input, struct ggml_tensor * ids,
+        struct ggml_tensor * table, struct ggml_tensor * gate, struct ggml_tensor * down,
+        int32_t dummy) {
+    GGML_ASSERT(input->type == GGML_TYPE_F32 && ggml_is_contiguous(input));
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && ids->ne[2] == 1 && ids->ne[3] == 1);
+    GGML_ASSERT(ggml_are_same_shape(up, gate));
+    GGML_ASSERT(up->ne[0] == input->ne[0] && input->ne[1] == 1 && input->ne[3] == 1);
+    GGML_ASSERT(input->ne[2] == ids->ne[1]);
+    GGML_ASSERT(down->ne[0] == up->ne[1] && down->ne[1] == up->ne[0]);
+    GGML_ASSERT(down->ne[2] == up->ne[2] && down->ne[3] == 1 && up->ne[3] == 1);
+    GGML_ASSERT(ggml_is_contiguous(up) && ggml_is_contiguous(gate) && ggml_is_contiguous(down));
+    if (table) {
+        GGML_ASSERT(table->type == GGML_TYPE_I32 && ggml_is_contiguous(table));
+        GGML_ASSERT(ggml_nelements(table) == up->ne[2]);
+    }
+    const int64_t ne[4] = { down->ne[1], ids->ne[0], ids->ne[1], 1 };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne);
+    result->op = GGML_OP_MOE_ROWS;
+    result->src[0] = up;
+    result->src[1] = input;
+    result->src[2] = ids;
+    result->src[3] = table;
+    result->src[4] = gate;
+    result->src[5] = down;
+    ggml_set_op_params_i32(result, 0, dummy);
+    return result;
+}
