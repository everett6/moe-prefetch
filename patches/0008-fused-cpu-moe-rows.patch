+static size_t ggml_moe_mmid_work_size(const struct ggml_tensor * weights,
+                                    enum ggml_type input_type, int64_t input_elements,
+                                    const struct ggml_tensor * ids) {
+    const enum ggml_type dot_type = type_traits_cpu[weights->type].vec_dot_type;
+    size_t size = input_type != dot_type ? ggml_row_size(dot_type, input_elements) + sizeof(int64_t) : 0;
+    const size_t n = weights->ne[2];
+    size += n * sizeof(int64_t) + sizeof(int64_t);
+    size += n * ids->ne[0] * ids->ne[1] * sizeof(struct mmid_row_mapping) + sizeof(int64_t);
+    size += CACHE_LINE_SIZE * n + CACHE_LINE_SIZE;
+    return size;
+}
+
+static size_t ggml_moe_rows_intermediate_size(const struct ggml_tensor * dst) {
+    const size_t bytes = sizeof(float) * dst->src[0]->ne[1] * dst->ne[1] * dst->ne[2];
+    return GGML_PAD(bytes, CACHE_LINE_SIZE);
+}
+
+static struct ggml_tensor ggml_moe_rows_intermediate(const struct ggml_tensor * dst, void * data) {
+    struct ggml_tensor result = *dst;
+    result.ne[0] = dst->src[0]->ne[1];
+    result.nb[0] = sizeof(float);
+    for (int i = 1; i < GGML_MAX_DIMS; ++i) {
+        result.nb[i] = result.nb[i-1] * result.ne[i-1];
+    }
+    result.data = data;
+    memset(result.src, 0, sizeof(result.src));
+    return result;
+}
+
+void ggml_cpu_moe_rows(const struct ggml_compute_params * params, struct ggml_tensor * dst) {
+    const size_t bytes = ggml_moe_rows_intermediate_size(dst);
+    GGML_ASSERT(params->wsize >= 3 * bytes + CACHE_LINE_SIZE);
+    // The common all-hit layer needs only observation and zero output rows.
+    if (dst->src[3]) {
+        int32_t * has_miss = (int32_t *) ((char *) params->wdata + 3 * bytes);
+        if (params->ith == 0) {
+            const struct ggml_tensor * ids = dst->src[2];
+            const int32_t * table = (const int32_t *) dst->src[3]->data;
+            const int32_t dummy = ggml_get_op_params_i32(dst, 0);
+            *has_miss = 0;
+            for (int64_t t = 0; t < ids->ne[1]; ++t) {
+                for (int64_t e = 0; e < ids->ne[0]; ++e) {
+                    const int32_t id = *(const int32_t *) ((const char *) ids->data + t * ids->nb[1] + e * ids->nb[0]);
+                    GGML_ASSERT(id >= 0 && id < dst->src[0]->ne[2]);
+                    if (table[id] == dummy) {
+                        *has_miss = 1;
+                    }
+                }
+            }
+        }
+        ggml_barrier(params->threadpool);
+        const bool miss = *has_miss != 0;
+        if (!miss) {
+            if (params->ith == 0) {
+                ggml_cpu_moe_observe(dst->src[4], dst->src[2]);
+            }
+            const int64_t rows = ggml_nrows(dst);
+            const int64_t first = rows * params->ith / params->nth;
+            const int64_t last = rows * (params->ith + 1) / params->nth;
+            memset((char *) dst->data + first * dst->nb[1], 0, (last - first) * dst->nb[1]);
+            return;
+        }
+    }
+    struct ggml_compute_params sub = *params;
+    sub.wdata = (char *) params->wdata + 3 * bytes + CACHE_LINE_SIZE;
+    sub.wsize -= 3 * bytes + CACHE_LINE_SIZE;
+    struct ggml_tensor up   = ggml_moe_rows_intermediate(dst, params->wdata);
+    struct ggml_tensor gate = ggml_moe_rows_intermediate(dst, (char *) params->wdata + bytes);
+    struct ggml_tensor act  = ggml_moe_rows_intermediate(dst, (char *) params->wdata + 2 * bytes);
+    up.op = gate.op = GGML_OP_MUL_MAT_ID;
+    up.src[0] = dst->src[0];
+    gate.src[0] = dst->src[4];
+    up.src[1] = gate.src[1] = dst->src[1];
+    up.src[2] = gate.src[2] = dst->src[2];
+    up.src[3] = gate.src[3] = dst->src[3];
+    ggml_compute_forward_mul_mat_id(&sub, &up);
+    ggml_barrier(params->threadpool);
+    ggml_compute_forward_mul_mat_id(&sub, &gate);
+    ggml_barrier(params->threadpool);
+    act.op = GGML_OP_GLU;
+    act.src[0] = &gate;
+    act.src[1] = &up;
+    memset(act.op_params, 0, sizeof(act.op_params));
+    ggml_set_op_params_i32(&act, 0, GGML_GLU_OP_SWIGLU);
+    ggml_compute_forward_glu(&sub, &act);
+    ggml_barrier(params->threadpool);
+    struct ggml_tensor down = *dst;
+    down.op = GGML_OP_MUL_MAT_ID;
+    memset(down.src, 0, sizeof(down.src));
+    down.src[0] = dst->src[5];
+    down.src[1] = &act;
+    down.src[2] = dst->src[2];
+    down.src[3] = dst->src[3];
+    ggml_compute_forward_mul_mat_id(&sub, &down);
+}
