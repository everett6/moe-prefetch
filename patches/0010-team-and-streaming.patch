+// ---------------------------------------------------------------- lookahead --
+
+#define MOE_AHEAD_WARPS 8
+
+// one warp per (target, expert): s = w[e] . (x * r)
+static __global__ void k_moe_ahead_scores(const float * x,
+                                          const float * w0, const float * r0,
+                                          const float * w1, const float * r1,
+                                          int n_embd, int n_expert, float * scores) {
+    const int t    = blockIdx.y;
+    const int lane = threadIdx.x % WARP_SIZE;
+    const int e    = blockIdx.x * MOE_AHEAD_WARPS + threadIdx.x / WARP_SIZE;
+    if (e >= n_expert) {
+        return;
+    }
+    const float * w = (t == 0 ? w0 : w1) + (size_t) e * n_embd;
+    const float * r = t == 0 ? r0 : r1;
+    float s = 0.0f;
+    for (int i = lane; i < n_embd; i += WARP_SIZE) {
+        s += w[i] * (x[i] * r[i]);
+    }
+    s = warp_reduce_sum(s);
+    if (lane == 0) {
+        scores[(size_t) t * n_expert + e] = s;
+    }
+}
+
+// one warp per target picks its top k (best first) and keeps the ones the
+// device table says are not resident; thread 0 then posts the record
+static __global__ void k_moe_ahead_post(const float * scores, const int32_t * tbl0, const int32_t * tbl1,
+                                        int n_targets, int n_expert, int k, int layer,
+                                        int target0, int target1, int dummy0, int dummy1,
+                                        ggml_moe_sc_ctl * ctl, ggml_moe_sc_dev * dev) {
+    __shared__ int32_t s_ids[2][GGML_MOE_SC_MAX_AHEAD];
+    __shared__ uint32_t s_n[2];
+    const int t    = threadIdx.x / WARP_SIZE;
+    const int lane = threadIdx.x % WARP_SIZE;
+    if (t < 2 && lane == 0) {
+        s_n[t] = 0;
+    }
+    __syncwarp();
+    if (t < n_targets) {
+        const float   * sc    = scores + (size_t) t * n_expert;
+        const int32_t * tbl   = t == 0 ? tbl0 : tbl1;
+        const int32_t   dummy = t == 0 ? dummy0 : dummy1;
+        uint32_t taken = 0;   // bit j: this lane's j-th expert (lane + 32 j) already picked
+        for (int round = 0; round < k; ++round) {
+            float best = -INFINITY;
+            int   bi   = -1;
+            for (int j = 0, e = lane; e < n_expert; ++j, e += WARP_SIZE) {
+                if (!(taken & (1u << j)) && (bi < 0 || sc[e] > best)) {
+                    best = sc[e];
+                    bi   = e;
+                }
+            }
+            // warp argmax; the lower expert id wins a tie
+#pragma unroll
+            for (int off = WARP_SIZE / 2; off > 0; off >>= 1) {
+                const float ob = __shfl_xor_sync(0xffffffff, best, off);
+                const int   oi = __shfl_xor_sync(0xffffffff, bi, off);
+                if (oi >= 0 && (bi < 0 || ob > best || (ob == best && oi < bi))) {
+                    best = ob;
+                    bi   = oi;
+                }
+            }
+            if (bi < 0) {
+                break;
+            }
+            if (bi % WARP_SIZE == lane) {
+                taken |= 1u << (bi / WARP_SIZE);
+            }
+            if (lane == 0 && tbl[bi] == dummy) {
+                s_ids[t][s_n[t]++] = bi;
+            }
+        }
+    }
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        const uint32_t seq = dev->ahead_seq;
+        ggml_moe_sc_ahead * r = &ctl->ahead[seq % GGML_MOE_SC_RING];
+        r->seq       = seq;
+        r->layer     = (uint32_t) layer;
+        r->target[0] = target0;
+        r->target[1] = n_targets > 1 ? target1 : -1;
+        r->t_ns      = moe_sc_now();
+        for (int tt = 0; tt < 2; ++tt) {
+            const uint32_t n = tt < n_targets ? s_n[tt] : 0;
+            r->n[tt] = n;
+            for (uint32_t j = 0; j < n; ++j) {
+                r->ids[tt][j] = s_ids[tt][j];
+            }
+        }
+        __threadfence_system();
+        dev->ahead_seq = seq + 1;
+        *(volatile uint32_t *) &ctl->ahead_head = seq + 1;
+    }
+}
+
+void ggml_cuda_op_moe_ahead(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const int32_t * p = (const int32_t *) dst->op_params;
+    const int layer = p[0], n_targets = p[1], target0 = p[2], target1 = p[3];
+    const int dummy0 = p[4], dummy1 = p[5], k = p[6];
+    ggml_moe_sc_ctl * ctl;
+    ggml_moe_sc_dev * dev;
+    memcpy(&ctl, p + 7, sizeof(void *));
+    memcpy(&dev, p + 9, sizeof(void *));
+    const ggml_tensor * x = dst->src[0];
+    const int n_embd   = (int) x->ne[0];
+    const int n_expert = (int) dst->src[1]->ne[1];
+    const float * w1 = n_targets > 1 ? (const float *) dst->src[4]->data : nullptr;
+    const float * r1 = n_targets > 1 ? (const float *) dst->src[5]->data : nullptr;
+    const int32_t * t1 = n_targets > 1 ? (const int32_t *) dst->src[6]->data : nullptr;
+    float * scores = (float *) dst->data;
+    const dim3 grid((n_expert + MOE_AHEAD_WARPS - 1) / MOE_AHEAD_WARPS, n_targets);
+    k_moe_ahead_scores<<<grid, MOE_AHEAD_WARPS * WARP_SIZE, 0, ctx.stream()>>>((const float *) x->data,
+        (const float *) dst->src[1]->data, (const float *) dst->src[2]->data, w1, r1, n_embd, n_expert, scores);
+    CUDA_CHECK(cudaGetLastError());
+    k_moe_ahead_post<<<1, 2 * WARP_SIZE, 0, ctx.stream()>>>(scores, (const int32_t *) dst->src[3]->data, t1,
+        n_targets, n_expert, k, layer, target0, target1, dummy0, dummy1, ctl, dev);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+// --------------------------------------------------------------- copy queue --
+// The mover's copies: host->device on one non-blocking stream, each push
+// followed by an event, so completion is learned without a synchronisation.
+// A push is ordered after every earlier push, which is what makes "copy the
+// expert, then write its table word" safe as two parts of one push.
+
+struct moe_mover {
+    int                       device = 0;
+    cudaStream_t              stream = nullptr;
+    std::vector<cudaEvent_t>  ev;
+    std::vector<int64_t>      ticket;
+    int                       head = 0, count = 0;
+    int64_t                   next_ticket = 1, done_ticket = 0;
+    int32_t                 * words = nullptr;   // pinned: words[s] == s, the source of every table write
+    int                       n_words = 0;
+};
+
+extern "C" void ggml_backend_cuda_moe_mover_free(void * handle);
+
+extern "C" void * ggml_backend_cuda_moe_mover_new(int device, int max_pending, int n_words) {
+    if (max_pending < 1 || n_words < 1) {
+        return nullptr;
+    }
+    ggml_cuda_set_device(device);
+    auto * m = new moe_mover();
+    m->device  = device;
+    m->n_words = n_words;
+    bool ok = cudaStreamCreateWithFlags(&m->stream, cudaStreamNonBlocking) == cudaSuccess &&
+              cudaHostAlloc((void **) &m->words, (size_t) n_words * sizeof(int32_t), cudaHostAllocPortable) == cudaSuccess;
+    if (ok) {
+        for (int s = 0; s < n_words; ++s) {
+            m->words[s] = s;
+        }
+        m->ev.assign(max_pending, nullptr);
+        m->ticket.assign(max_pending, 0);
+        for (auto & e : m->ev) {
+            ok = ok && cudaEventCreateWithFlags(&e, cudaEventDisableTiming) == cudaSuccess;
+        }
+    }
+    if (!ok) {
+        (void) cudaGetLastError();
+        ggml_backend_cuda_moe_mover_free(m);
+        return nullptr;
+    }
+    return m;
+}
+
+extern "C" void ggml_backend_cuda_moe_mover_free(void * handle) {
+    auto * m = (moe_mover *) handle;
+    if (!m) {
+        return;
+    }
+    ggml_cuda_set_device(m->device);
+    if (m->stream) {
+        cudaStreamSynchronize(m->stream);
+    }
+    for (auto e : m->ev) {
+        if (e) {
+            cudaEventDestroy(e);
+        }
+    }
+    if (m->stream) {
+        cudaStreamDestroy(m->stream);
+    }
+    if (m->words) {
+        cudaFreeHost(m->words);
+    }
+    (void) cudaGetLastError();
+    delete m;
+}
+
+// the pinned word holding `slot`, to be used as the source of a table write
+extern "C" const int32_t * ggml_backend_cuda_moe_mover_word(void * handle, int slot) {
+    auto * m = (moe_mover *) handle;
+    return slot >= 0 && slot < m->n_words ? m->words + slot : nullptr;
+}
+
+// highest ticket whose copies have all landed; never blocks. -1 on a CUDA error.
+extern "C" int64_t ggml_backend_cuda_moe_mover_done(void * handle) {
+    auto * m = (moe_mover *) handle;
+    ggml_cuda_set_device(m->device);
+    while (m->count > 0) {
+        const cudaError_t err = cudaEventQuery(m->ev[m->head]);
+        if (err == cudaErrorNotReady) {
+            (void) cudaGetLastError();
+            break;
+        }
+        if (err != cudaSuccess) {
+            (void) cudaGetLastError();
+            return -1;
+        }
+        m->done_ticket = m->ticket[m->head];
+        m->head = (m->head + 1) % (int) m->ev.size();
+        m->count--;
+    }
+    return m->done_ticket;
+}
+
+// copies n ranges in order, then records an event. The ticket, 0 when the
+// queue is full (call done() and retry), or -1 on a CUDA error.
+extern "C" int64_t ggml_backend_cuda_moe_mover_push(void * handle, void ** dst, const void ** src, const size_t * n, int count) {
+    auto * m = (moe_mover *) handle;
+    if (m->count == (int) m->ev.size() && ggml_backend_cuda_moe_mover_done(handle) >= 0 && m->count == (int) m->ev.size()) {
+        return 0;
+    }
+    ggml_cuda_set_device(m->device);
+    for (int i = 0; i < count; ++i) {
+        if (cudaMemcpyAsync(dst[i], src[i], n[i], cudaMemcpyHostToDevice, m->stream) != cudaSuccess) {
+            (void) cudaGetLastError();
+            return -1;
+        }
+    }
+    const int slot = (m->head + m->count) % (int) m->ev.size();
+    if (cudaEventRecord(m->ev[slot], m->stream) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return -1;
+    }
+    m->ticket[slot] = m->next_ticket++;
+    m->count++;
+    return m->ticket[slot];
+}
+
+// wait for everything pushed so far; the done ticket afterwards, -1 on error
+extern "C" int64_t ggml_backend_cuda_moe_mover_sync(void * handle) {
+    auto * m = (moe_mover *) handle;
+    ggml_cuda_set_device(m->device);
+    if (cudaStreamSynchronize(m->stream) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return -1;
+    }
+    return ggml_backend_cuda_moe_mover_done(handle);
+}
+
+extern "C" bool ggml_backend_cuda_moe_is_pinned(const void * ptr) {
+    cudaPointerAttributes a;
+    if (cudaPointerGetAttributes(&a, ptr) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return false;
+    }
+    return a.type == cudaMemoryTypeHost;
+}
