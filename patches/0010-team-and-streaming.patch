+        const uint64_t deadline = now + (lead > st->margin_ns ? lead - st->margin_ns : 0);
+        const size_t bytes = expert_bytes(ls);
+        for (uint32_t j = 0; j < rec.n[t] && j < GGML_MOE_SC_MAX_AHEAD; ++j) {
+            const int32_t e = rec.ids[t][j];
+            if (e < 0 || e >= (int32_t) ls.expert_slot.size() || ls.expert_slot[e] >= 0) {
+                continue;
+            }
+            if (st->mark[T][e]) {
+                st->planner.offer(T, e, bytes, deadline);   // already a job: may tighten its deadline
+                continue;
+            }
+            if (st->n_this_token[li] >= st->per_layer) {
+                continue;
+            }
+            if ((int) ls.free_slots.size() <= mc->max_inserts) {
+                st->n_not_sent++;                           // the demand path keeps its share
+                continue;
+            }
+            if (worker_has_job(mc, li, e)) {
+                continue;
+            }
+            const int id = st->planner.offer(T, e, bytes, deadline);
+            if (id < 0) {
+                continue;                                   // the layer has read its table already
+            }
+            GGML_ASSERT(id == (int) st->jobs.size());
+            moe_stream::sjob sj;
+            sj.li   = li;
+            sj.slot = ls.free_slots.back();
+            sj.d    = d;
+            ls.free_slots.pop_back();
+            ls.slot_in_flight[sj.slot] = true;
+            st->jobs.push_back(sj);
+            st->mark[T][e] = id + 1;
+            st->n_this_token[li]++;
+            st->n_offered++;
+        }
+    }
+}
