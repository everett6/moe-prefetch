diff --git a/src/llama-moe-planner.h b/src/llama-moe-planner.h
new file mode 100644
index 0000000..ca494de
--- /dev/null
+++ b/src/llama-moe-planner.h
@@ -0,0 +1,134 @@
+#pragma once
+
+// Just-in-time expert streaming: which copy goes on the copy engine next.
+// Pure bookkeeping (no CUDA, no locks); the mover thread owns one and calls it
+// from one thread. Tested by moe-prefetch cpp/test-moe-planner.cpp.
+//
+// A job is one expert (its three slices, `bytes` in all) wanted by layer
+// `target` before `deadline_ns`. Jobs go out earliest-deadline-first in chunks
+// of at most chunk_bytes, so an urgent job waits at most one chunk behind a
+// less urgent one. A job that can no longer land before its deadline is dropped
+// rather than sent late, and so are the unfinished jobs of a layer that has
+// already read its table.
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+class moe_planner {
+public:
+    enum drop_reason { DROP_NONE = 0, DROP_LATE, DROP_POSTED };
+
+    struct job {
+        int         target;
+        int32_t     expert;
+        size_t      bytes;
+        size_t      sent = 0;
+        uint64_t    deadline_ns;
+        bool        dropped = false;
+        drop_reason drop = DROP_NONE;
+    };
+
+    struct chunk {
+        int    job;
+        size_t offset;
+        size_t len;
+        bool   last;     // the job's final chunk: its table word goes right after it
+    };
+
+    explicit moe_planner(size_t chunk_bytes) : chunk_bytes(chunk_bytes) {}
+
+    // token boundary: forget every job and every posted layer
+    void reset() {
+        jobs.clear();
+        posted_layers.clear();
+    }
+
+    // The new job's id, or -1 if (target, expert) already has a job or the
+    // target has already read its table. A repeat offer with an earlier
+    // deadline tightens the existing job (a d = 1 refresh of a d = 2 guess).
+    int offer(int target, int32_t expert, size_t bytes, uint64_t deadline_ns) {
+        for (int l : posted_layers) {
+            if (l == target) {
+                return -1;
+            }
+        }
+        for (auto & j : jobs) {
+            if (j.target == target && j.expert == expert) {
+                if (!j.dropped && deadline_ns < j.deadline_ns) {
+                    j.deadline_ns = deadline_ns;
+                }
+                n_dup++;
+                return -1;
+            }
+        }
+        job j;
+        j.target      = target;
+        j.expert      = expert;
+        j.bytes       = bytes;
+        j.deadline_ns = deadline_ns;
+        jobs.push_back(j);
+        n_offered++;
+        return (int) jobs.size() - 1;
+    }
+
+    // layer `target` has read its table: its unfinished jobs can no longer help
+    void posted(int target) {
+        posted_layers.push_back(target);
+        for (auto & j : jobs) {
+            if (j.target == target && !j.dropped && j.sent < j.bytes) {
+                j.dropped = true;
+                j.drop    = DROP_POSTED;
+                n_drop_posted++;
+            }
+        }
+    }
+
+    // The next chunk to copy. free_at_ns: when the copy engine will have
+    // finished what is already queued on it. hold_after >= 0: jobs whose
+    // target is beyond that layer wait (the CPU is computing a miss and a copy
+    // would slow it). False when nothing can go now.
+    bool next(uint64_t free_at_ns, double bytes_per_ns, int hold_after, chunk & out) {
+        int best = -1;
+        for (int i = 0; i < (int) jobs.size(); ++i) {
+            job & j = jobs[i];
+            if (j.dropped || j.sent >= j.bytes) {
+                continue;
+            }
+            const uint64_t finish = free_at_ns + (uint64_t) ((double) (j.bytes - j.sent) / bytes_per_ns);
+            if (finish > j.deadline_ns) {
+                j.dropped = true;
+                j.drop    = DROP_LATE;
+                n_drop_late++;
+                continue;
+            }
+            if (hold_after >= 0 && j.target > hold_after) {
+                continue;
+            }
+            if (best < 0 || j.deadline_ns < jobs[best].deadline_ns) {
+                best = i;
+            }
+        }
+        if (best < 0) {
+            return false;
+        }
+        job & j = jobs[best];
+        const size_t remaining = j.bytes - j.sent;
+        out.job    = best;
+        out.offset = j.sent;
+        out.len    = remaining < chunk_bytes ? remaining : chunk_bytes;
+        out.last   = out.len == remaining;
+        j.sent    += out.len;
+        return true;
+    }
+
+    const job & get(int id) const { return jobs[id]; }
+    size_t size() const { return jobs.size(); }
+
+    uint64_t n_offered = 0, n_dup = 0, n_drop_late = 0, n_drop_posted = 0;
+
+private:
+    size_t           chunk_bytes;
+    std::vector<job> jobs;
+    std::vector<int> posted_layers;
+};
