+// Persistent team for one-op jobs (MoE sidecar). See ggml-cpu.h. Built on one
+// OpenMP region so that ggml_barrier (an omp barrier in this build) and the
+// threadpool's chunk counters work exactly as they do inside a graph.
+struct ggml_cpu_team {
+    struct ggml_threadpool * tp;
+    int                      n_threads;
+    int                      first_cpu;
+    size_t                   work_size;
+    uint8_t                * work;
+    struct ggml_tensor     * job;            // written by member 0 before gen is released
+    atomic_int GGML_CACHE_ALIGN gen;         // one increment per job handed out, NULL included
+};
+
+struct ggml_cpu_team * ggml_cpu_team_new(int n_threads, size_t work_size, int first_cpu) {
+#ifdef GGML_USE_OPENMP
+    if (n_threads < 1 || n_threads > GGML_MAX_N_THREADS) {
+        return NULL;
+    }
+    ggml_cpu_init();
+    struct ggml_cpu_team * team = ggml_aligned_malloc(sizeof(struct ggml_cpu_team));
+    if (!team) {
+        return NULL;
+    }
+    memset(team, 0, sizeof(*team));
+    struct ggml_threadpool_params tpp = ggml_threadpool_params_default(n_threads);
+    team->tp        = ggml_threadpool_new_impl(&tpp, NULL, NULL);
+    team->n_threads = n_threads;
+    team->first_cpu = first_cpu;
+    team->work_size = work_size;
+    team->work      = work_size ? ggml_aligned_malloc(work_size) : NULL;
+    atomic_store_explicit(&team->gen, 0, memory_order_relaxed);
+    if (!team->tp || (work_size && !team->work)) {
+        ggml_cpu_team_free(team);
+        return NULL;
+    }
+    return team;
+#else
+    GGML_UNUSED(n_threads);
+    GGML_UNUSED(work_size);
+    GGML_UNUSED(first_cpu);
+    return NULL;
+#endif
+}
+
+void ggml_cpu_team_free(struct ggml_cpu_team * team) {
+    if (!team) {
+        return;
+    }
+    if (team->tp) {
+        ggml_threadpool_free(team->tp);
+    }
+    if (team->work) {
+        ggml_aligned_free(team->work, team->work_size);
+    }
+    ggml_aligned_free(team, sizeof(struct ggml_cpu_team));
+}
+
+void ggml_cpu_team_run(struct ggml_cpu_team * team,
+                       struct ggml_tensor * (*next)(void * ud),
+                       void (*done)(void * ud, struct ggml_tensor * node),
+                       void * ud) {
+#ifdef GGML_USE_OPENMP
+    struct ggml_threadpool * tp = team->tp;
+    tp->current_chunk = 0;
+    tp->abort         = -1;
+    tp->ec            = GGML_STATUS_SUCCESS;
+    const int base = atomic_load_explicit(&team->gen, memory_order_relaxed);
+
+    #pragma omp parallel num_threads(team->n_threads)
+    {
+        #pragma omp single
+        {
+            atomic_store_explicit(&tp->n_graph, omp_get_num_threads(), memory_order_relaxed);
+        }
+        const int ith = omp_get_thread_num();
+        const int nth = omp_get_num_threads();
+        if (team->first_cpu >= 0 && team->first_cpu + ith < GGML_MAX_N_THREADS) {
+            bool mask[GGML_MAX_N_THREADS] = { false };
+            mask[team->first_cpu + ith] = true;
+            ggml_thread_apply_affinity(mask);
+        }
+        struct ggml_compute_params params = {
+            /*.ith        =*/ ith,
+            /*.nth        =*/ nth,
+            /*.wsize      =*/ team->work_size,
+            /*.wdata      =*/ team->work,
+            /*.threadpool =*/ tp,
+            /*.use_ref    =*/ false,
+        };
+        int gen = base;
+        for (;;) {
+            struct ggml_tensor * node;
+            if (ith == 0) {
+                node = next(ud);
+                team->job = node;
+                atomic_store_explicit(&team->gen, gen + 1, memory_order_release);
+            } else {
+                while (atomic_load_explicit(&team->gen, memory_order_acquire) == gen) {
+                    ggml_thread_cpu_relax();
+                }
+                node = team->job;
+            }
+            ++gen;
+            if (!node) {
+                break;
+            }
+            // member 0 cannot hand out the next job before every member has
+            // passed this barrier, so `team->job` is never overwritten early
+            ggml_compute_forward(&params, node);
+            ggml_barrier(tp);
+            if (ith == 0) {
+                done(ud, node);
+            }
+        }
+    }
+#else
+    GGML_UNUSED(team);
+    GGML_UNUSED(next);
+    GGML_UNUSED(done);
+    GGML_UNUSED(ud);
+    GGML_ABORT("ggml_cpu_team_run needs an OpenMP build; ggml_cpu_team_new returns NULL without one");
+#endif
+}
+
