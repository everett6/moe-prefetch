+    const uint64_t routed = st->n_in_time + st->n_late;
+    fprintf(stderr, "moe-cache: stream %s: per token offered %.2f, landed %.2f, in time %.2f, late %.2f, unused %.2f, "
+            "dropped late %.2f, dropped posted %.2f, no slot %.2f, misses left %.2f, %.1f MiB copied\n",
+            when, st->n_offered / steps, st->n_landed / steps, st->n_in_time / steps, st->n_late / steps,
+            st->n_unused / steps, st->n_drop_late / steps, st->n_drop_posted / steps, st->n_not_sent / steps,
+            st->n_gpu_miss / steps, st->n_bytes / 1048576.0 / steps);
+    fprintf(stderr, "moe-cache: stream %s: served from VRAM %.1f%% of would-be misses, %.1f%% of landed copies used in time, "
+            "%" PRIu64 " routed; lead d1 %.1f us (%" PRIu64 "), d2 %.1f us (%" PRIu64 "); tau %.1f us%s\n",
+            when, st->n_in_time + st->n_gpu_miss ? 100.0 * st->n_in_time / (st->n_in_time + st->n_gpu_miss) : 0.0,
+            st->n_landed ? 100.0 * st->n_in_time / st->n_landed : 0.0, routed,
+            st->lead_n[1] ? st->lead_sum[1] / st->lead_n[1] / 1000.0 : 0.0, st->lead_n[1],
+            st->lead_n[2] ? st->lead_sum[2] / st->lead_n[2] / 1000.0 : 0.0, st->lead_n[2],
+            st->tau_ns / 1000.0, st->failed ? " (FAILED, stopped)" : "");
+    fprintf(stderr, "moe-cache: stream %s totals: steps=%" PRIu64 " offered=%" PRIu64 " landed=%" PRIu64
+            " in_time=%" PRIu64 " late=%" PRIu64 " unused=%" PRIu64 " gpu_miss=%" PRIu64 " failed=%d\n",
+            when, mc->n_steps, st->n_offered, st->n_landed, st->n_in_time, st->n_late, st->n_unused,
+            st->n_gpu_miss, (int) st->failed);
+    fflush(stderr);
+}
