+// copies whose event has fired: the expert and its table word are on the device
+static void stream_reap(moe_cache * mc, int64_t done) {
+    moe_stream * st = mc->st;
+    if (done < 0) {
+        fprintf(stderr, "moe-cache: stream copy queue error; streaming stops for this run\n");
+        st->failed = true;
+        return;
+    }
+    size_t k = 0;
+    while (k < st->outstanding.size() && st->outstanding[k].first <= done) {
+        ++k;
+    }
+    st->outstanding.erase(st->outstanding.begin(), st->outstanding.begin() + k);
+    std::lock_guard<std::mutex> lk(mc->mtx);
+    for (auto & j : st->jobs) {
+        if (j.ticket > 0 && j.ticket <= done && !j.landed) {
+            j.landed = true;
+            st->n_landed++;
+        }
+    }
+}
+
+// hand the copy engine the next chunks, up to max_outstanding bytes in flight
+static bool stream_issue(moe_cache * mc) {
+    moe_stream * st = mc->st;
+    size_t queued = 0;
+    for (const auto & o : st->outstanding) {
+        queued += o.second;
+    }
+    bool any = false;
+    while (queued < st->max_outstanding && st->outstanding.size() < 32) {
+        // while the CPU computes a miss, a copy for a layer further out would slow it
+        const int comp = mc->sc->computing.load(std::memory_order_relaxed);
+        const uint64_t free_at = mono_ns() + (uint64_t) ((double) queued / st->bytes_per_ns);
+        moe_planner::chunk c;
+        if (!st->planner.next(free_at, st->bytes_per_ns, comp >= 0 ? comp + 1 : -1, c)) {
+            break;
+        }
+        const moe_planner::job & pj = st->planner.get(c.job);
+        const moe_stream::sjob & sj = st->jobs[c.job];   // li and slot never change; only this thread appends
+        const layer_state & ls = mc->layers[sj.li];
+        void *       dst[4];
+        const void * src[4];
+        size_t       n[4];
+        int k = stream_ranges(ls, pj.expert, sj.slot, c.offset, c.len, dst, src, n);
+        if (c.last) {
+            // the table word, ordered after the expert's last byte on the same stream
+            dst[k] = (char *) ls.pub.dev_table->data + (size_t) pj.expert * sizeof(int32_t);
+            src[k] = st->mover_word(st->mover, sj.slot);
+            n[k]   = sizeof(int32_t);
+            GGML_ASSERT(src[k]);
+            ++k;
+        }
+        const int64_t ticket = st->mover_push(st->mover, dst, src, n, k);
+        if (ticket <= 0) {
+            fprintf(stderr, "moe-cache: stream copy push failed (%" PRId64 "); streaming stops for this run\n", ticket);
+            st->failed = true;
+            return any;
+        }
+        st->outstanding.push_back({ ticket, c.len });
+        queued += c.len;
+        st->n_bytes += c.len;
+        if (c.last) {
+            std::lock_guard<std::mutex> lk(mc->mtx);
+            st->jobs[c.job].ticket = ticket;
+        }
+        any = true;
+    }
+    return any;
+}
+
+static void stream_loop(moe_cache * mc) {
+    moe_stream  * st  = mc->st;
+    moe_sidecar * sc  = mc->sc;
+    const auto  * ctl = (const ggml_moe_sc_ctl *) sc->host;
+    int64_t last_done = 0;
+    for (;;) {
+        {
+            std::unique_lock<std::mutex> lk(st->m);
+            st->cv.wait(lk, [st]() { return st->quit || st->gen_started.load() != st->gen_done; });
+            if (st->quit) {
+                return;
+            }
+        }
+        const uint32_t gen = st->gen_started.load(std::memory_order_acquire);
+        while (sc->active.load(std::memory_order_acquire) && !st->failed) {
+            bool progress = false;
+            // layers that have read their tables first, so no job is offered for one of them
+            const uint32_t ph = st->posted_head.load(std::memory_order_acquire);
+            while (st->posted_tail != ph) {
+                st->planner.posted((int) st->posted_q[st->posted_tail % GGML_MOE_SC_RING]);
+                st->posted_tail++;
+                progress = true;
+            }
+            const uint32_t ah = __atomic_load_n(&ctl->ahead_head, __ATOMIC_ACQUIRE);
+            while (st->consumed != ah) {
+                const ggml_moe_sc_ahead rec = ctl->ahead[st->consumed % GGML_MOE_SC_RING];
+                if (rec.seq != st->consumed) {
+                    fprintf(stderr, "moe-cache: stream channel error: record seq %u, expected %u; streaming stops\n",
+                            rec.seq, st->consumed);
+                    st->failed = true;
+                    break;
                 }
+                stream_take(mc, rec, gen);
+                st->consumed++;
+                progress = true;
+            }
+            const int64_t done = st->mover_done(st->mover);
+            if (done != last_done) {
+                stream_reap(mc, done);
+                last_done = done;
+                progress = true;
+            }
+            if (!st->failed) {
+                progress |= stream_issue(mc);
+            }
+            if (!progress) {
+                MOE_SC_PAUSE();
             }
-            sc->n_records++;
-            sc->consumed++;
-            sc->consumed_pub.store(sc->consumed, std::memory_order_release);
         }
+        // The graph is over. Whatever landed stays; the rest is given back at the boundary.
+        const int64_t done = st->mover_sync(st->mover);
+        stream_reap(mc, done);
+        last_done = done;
+        st->outstanding.clear();
+        st->consumed    = __atomic_load_n(&ctl->ahead_head, __ATOMIC_ACQUIRE);
+        st->posted_tail = st->posted_head.load(std::memory_order_acquire);
+        st->last_layer  = UINT32_MAX;
+        {
+            std::lock_guard<std::mutex> lk(st->m);
+            st->gen_done = st->gen_started.load();
+        }
+        st->cv_done.notify_all();
+    }
+}
+
+// step(): the mover has finished every batch started so far, so nothing is in flight
+static void stream_quiesce(moe_cache * mc) {
+    moe_stream * st = mc->st;
+    std::unique_lock<std::mutex> lk(st->m);
+    if (!st->cv_done.wait_for(lk, std::chrono::seconds(2), [st]() { return st->gen_done == st->gen_started.load(); })) {
+        // adopting jobs while copies may still run could publish a torn expert
+        GGML_ABORT("moe-cache: stream mover did not stop within 2 s");
     }
 }
 
+// step(), mover idle, caller holds mc->mtx: landed experts join the cache, the
+// slots of the others go back to the pool (no table word was written for them)
+static void stream_adopt(moe_cache * mc) {
+    moe_stream * st = mc->st;
+    st->rec_used.clear();
+    for (size_t k = 0; k < st->jobs.size(); ++k) {
+        const moe_stream::sjob & sj = st->jobs[k];
+        const moe_planner::job & pj = st->planner.get((int) k);
+        layer_state & ls = mc->layers[sj.li];
+        const int32_t e = pj.expert;
+        ls.slot_in_flight[sj.slot] = false;
+        if (sj.in_time) {
+            st->rec_used.push_back({ (int32_t) sj.li, sj.slot, e });
+        }
+        if (sj.landed && ls.expert_slot[e] >= 0) {
+            // A worker copy of the same expert was published just now (it was
+            // between the worker's queues when the job was offered). Keep the
+            // worker's slot; this layer's table is rewritten from the mirrors
+            // at this step's flush, so the streamed slot is unreferenced again.
+            ls.free_slots.push_back(sj.slot);
+            st->n_unused += !sj.in_time && !sj.late;
+        } else if (sj.landed) {
+            ls.slot_expert[sj.slot] = e;
+            ls.expert_slot[e]       = sj.slot;
+            // routed: real demand, recent; not routed: the first to go
+            ls.slot_last_use[sj.slot] = sj.in_time || sj.late ? ++mc->clock : 1;
+            set_table_entry(mc, ls, e, sj.slot);   // the device word is already there; the mirrors follow
+            mc->n_published++;
+            if (!sj.in_time && !sj.late) {
+                st->n_unused++;
+            }
+        } else {
+            ls.free_slots.push_back(sj.slot);
+        }
+        st->mark[ls.pub.il][e] = 0;
+    }
+    st->n_drop_late   = st->planner.n_drop_late;
+    st->n_drop_posted = st->planner.n_drop_posted;
+    st->jobs.clear();
+    st->planner.reset();
+    std::fill(st->n_this_token.begin(), st->n_this_token.end(), 0);
+}
