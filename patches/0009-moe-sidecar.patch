diff --git a/ggml/src/ggml-cuda/moe-sidecar.cu b/ggml/src/ggml-cuda/moe-sidecar.cu
new file mode 100644
index 0000000..d091b17
--- /dev/null
+++ b/ggml/src/ggml-cuda/moe-sidecar.cu
@@ -0,0 +1,283 @@
+// MoE sidecar: the GPU publishes a layer's routed ids (and its input, if any
+// routed expert is not in the device cache) to mapped host memory, carries on
+// with the cached experts, and joins the host's rows afterwards. Protocol and
+// layout in ggml/include/ggml-moe-sidecar.h.
+//
+// Relies on a running kernel and a host thread seeing each other's stores to
+// mapped pinned memory without a stream synchronisation in between. That is
+// observed on this card and driver but not promised by the CUDA docs, which is
+// why ggml_backend_cuda_moe_sc_selftest exists and the caller runs it first.
+
+#include "moe-sidecar.cuh"
+#include "ggml-moe-sidecar.h"
+
+#include <atomic>
+#include <cstring>
+#include <thread>
+
+#define MOE_SC_TIMEOUT_NS 1000000000ull
+
+static __device__ __forceinline__ uint64_t moe_sc_now() {
+    uint64_t t;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t));
+    return t;
+}
+
+static void moe_sc_params(const ggml_tensor * t, int & layer, int & dummy,
+                          ggml_moe_sc_ctl *& ctl, ggml_moe_sc_dev *& dev) {
+    const int32_t * p = (const int32_t *) t->op_params;
+    layer = p[0];
+    dummy = p[1];
+    memcpy(&ctl, p + 2, sizeof(void *));
+    memcpy(&dev, p + 4, sizeof(void *));
+}
+
+static __global__ void k_moe_post(const float * x, float * out, const int32_t * ids, const int32_t * slots,
+                                  int n_used, int n_embd, int layer, int dummy,
+                                  ggml_moe_sc_ctl * ctl, float * host_x, ggml_moe_sc_dev * dev) {
+    __shared__ int      s_miss;
+    __shared__ uint32_t s_seq;
+    if (threadIdx.x == 0) {
+        int miss = 0;
+        for (int e = 0; e < n_used; ++e) {
+            miss |= slots[e] == dummy;
+        }
+        s_miss = miss;
+        s_seq  = dev->seq;
+    }
+    __syncthreads();
+    const int      miss = s_miss;
+    const uint32_t seq  = s_seq;
+    for (int i = threadIdx.x; i < n_embd; i += blockDim.x) {
+        const float v = x[i];
+        out[i] = v;
+        if (miss) {
+            host_x[i] = v;
+        }
+    }
+    if (threadIdx.x < n_used) {
+        ctl->ids[layer][threadIdx.x] = ids[threadIdx.x];
+    }
+    if (threadIdx.x == 0) {
+        ggml_moe_sc_record * r = &ctl->ring[seq % GGML_MOE_SC_RING];
+        r->seq   = seq;
+        r->layer = (uint32_t) layer;
+        r->miss  = (uint32_t) miss;
+    }
+    // every thread's stores reach the system before thread 0 announces them
+    __threadfence_system();
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        dev->posted_seq[layer]  = seq;
+        dev->posted_miss[layer] = (uint32_t) miss;
+        dev->seq = seq + 1;
+        __threadfence_system();
+        *(volatile uint32_t *) &ctl->head = seq + 1;
+    }
+}
+
+// one block per routed expert
+static __global__ void k_moe_join(const float * cached, float * out, const int32_t * slots,
+                                  int n_embd, int layer, int dummy,
+                                  ggml_moe_sc_ctl * ctl, const float * rows, const ggml_moe_sc_dev * dev) {
+    const int e = blockIdx.x;
+    __shared__ int s_host;
+    if (threadIdx.x == 0) {
+        int host = 0;
+        if (dev->posted_miss[layer] && slots[e] == dummy) {
+            const uint32_t want = dev->posted_seq[layer] + 1;
+            const uint64_t t0   = moe_sc_now();
+            host = 1;
+            while (*(volatile const uint32_t *) &ctl->resp[layer] != want) {
+                if (*(volatile const uint32_t *) &ctl->err != 0) {
+                    host = 0;
+                    break;
+                }
+                if (moe_sc_now() - t0 > MOE_SC_TIMEOUT_NS) {
+                    *(volatile uint32_t *) &ctl->err = 1;
+                    __threadfence_system();
+                    host = 0;
+                    break;
+                }
+            }
+            __threadfence_system();
+        }
+        s_host = host;
+    }
+    __syncthreads();
+    const volatile float * r = rows + (size_t) e * n_embd;
+    const float * c = cached + (size_t) e * n_embd;
+    float *       o = out    + (size_t) e * n_embd;
+    for (int i = threadIdx.x; i < n_embd; i += blockDim.x) {
+        // same order as ggml_add(host_rows, cached), where a cached expert's host row is +0
+        const float h = s_host ? r[i] : 0.0f;
+        o[i] = h + c[i];
+    }
+}
+
+void ggml_cuda_op_moe_post(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * x     = dst->src[0];
+    const ggml_tensor * ids   = dst->src[1];
+    const ggml_tensor * slots = dst->src[2];
+    int layer, dummy;
+    ggml_moe_sc_ctl * ctl;
+    ggml_moe_sc_dev * dev;
+    moe_sc_params(dst, layer, dummy, ctl, dev);
+    const int n_embd = (int) x->ne[0];
+    float * host_x = ggml_moe_sc_x(ctl, n_embd, layer);
+    k_moe_post<<<1, 256, 0, ctx.stream()>>>((const float *) x->data, (float *) dst->data,
+        (const int32_t *) ids->data, (const int32_t *) slots->data, (int) ggml_nelements(ids), n_embd,
+        layer, dummy, ctl, host_x, dev);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void ggml_cuda_op_moe_join(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * cached = dst->src[0];
+    const ggml_tensor * slots  = dst->src[1];
+    int layer, dummy;
+    ggml_moe_sc_ctl * ctl;
+    ggml_moe_sc_dev * dev;
+    moe_sc_params(dst, layer, dummy, ctl, dev);
+    const int n_embd = (int) cached->ne[0];
+    const float * rows = ggml_moe_sc_rows(ctl, n_embd, layer);
+    k_moe_join<<<(int) cached->ne[1], 256, 0, ctx.stream()>>>((const float *) cached->data, (float *) dst->data,
+        (const int32_t *) slots->data, n_embd, layer, dummy, ctl, rows, dev);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+extern "C" bool ggml_backend_cuda_moe_sc_alloc(int device, int n_embd, void ** host, void ** host_dev, void ** dev_state) {
+    ggml_cuda_set_device(device);
+    const size_t bytes = ggml_moe_sc_host_bytes(n_embd);
+    *host = nullptr;
+    *dev_state = nullptr;
+    if (cudaHostAlloc(host, bytes, cudaHostAllocMapped | cudaHostAllocPortable) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return false;
+    }
+    memset(*host, 0, bytes);
+    if (cudaHostGetDevicePointer(host_dev, *host, 0) != cudaSuccess ||
+        cudaMalloc(dev_state, sizeof(ggml_moe_sc_dev)) != cudaSuccess ||
+        cudaMemset(*dev_state, 0, sizeof(ggml_moe_sc_dev)) != cudaSuccess ||
+        cudaDeviceSynchronize() != cudaSuccess) {
+        (void) cudaGetLastError();
+        ggml_backend_cuda_moe_sc_free(*host, *dev_state);
+        *host = nullptr;
+        *dev_state = nullptr;
+        return false;
+    }
+    return true;
+}
+
+extern "C" void ggml_backend_cuda_moe_sc_free(void * host, void * dev_state) {
+    if (host) {
+        cudaFreeHost(host);
+    }
+    if (dev_state) {
+        cudaFree(dev_state);
+    }
+}
+
+// ---------------------------------------------------------------- self-test --
+
+static __host__ __device__ float moe_sc_pattern(uint32_t k, int i, uint32_t salt) {
+    uint32_t h = k * 2654435761u ^ (uint32_t) i * 40503u ^ salt;
+    h ^= h >> 13;
+    h *= 0x5bd1e995u;
+    h ^= h >> 15;
+    return (float) (h & 0xffffff) * (1.0f / 16777216.0f) - 0.5f;
+}
+
+#define MOE_SC_TEST_N 1024
+
+// n round trips through the same words and buffers the decode path uses
+static __global__ void k_moe_sc_selftest(ggml_moe_sc_ctl * ctl, float * host_x, const float * rows, int n, unsigned int * bad) {
+    __shared__ int s_ok;
+    for (int k = 0; k < n; ++k) {
+        for (int i = threadIdx.x; i < MOE_SC_TEST_N; i += blockDim.x) {
+            host_x[i] = moe_sc_pattern((uint32_t) k, i, 0x1234u);
+        }
+        __threadfence_system();
+        __syncthreads();
+        if (threadIdx.x == 0) {
+            *(volatile uint32_t *) &ctl->head = (uint32_t) k + 1;
+            const uint64_t t0 = moe_sc_now();
+            int ok = 1;
+            while (*(volatile const uint32_t *) &ctl->resp[0] != (uint32_t) k + 1) {
+                if (moe_sc_now() - t0 > MOE_SC_TIMEOUT_NS) {
+                    ok = 0;
+                    break;
+                }
+            }
+            __threadfence_system();
+            s_ok = ok;
+        }
+        __syncthreads();
+        if (!s_ok) {
+            if (threadIdx.x == 0) {
+                atomicAdd(bad, (unsigned int) (n - k));
+            }
+            return;
+        }
+        const volatile float * r = rows;
+        for (int i = threadIdx.x; i < MOE_SC_TEST_N; i += blockDim.x) {
+            if (r[i] != moe_sc_pattern((uint32_t) k, i, 0x9876u)) {
+                atomicAdd(bad, 1u);
+            }
+        }
+        __syncthreads();
+    }
+}
+
+extern "C" int ggml_backend_cuda_moe_sc_selftest(int device, int n) {
+    void * host = nullptr;
+    void * host_dev = nullptr;
+    void * dev_state = nullptr;
+    if (!ggml_backend_cuda_moe_sc_alloc(device, MOE_SC_TEST_N, &host, &host_dev, &dev_state)) {
+        return -1;
+    }
+    ggml_moe_sc_ctl * ctl = (ggml_moe_sc_ctl *) host;
+    unsigned int * bad = nullptr;
+    cudaStream_t stream = nullptr;
+    if (cudaMalloc(&bad, sizeof(unsigned int)) != cudaSuccess || cudaMemset(bad, 0, sizeof(unsigned int)) != cudaSuccess ||
+        cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking) != cudaSuccess) {
+        (void) cudaGetLastError();
+        cudaFree(bad);
+        ggml_backend_cuda_moe_sc_free(host, dev_state);
+        return -1;
+    }
+    std::atomic<int> host_bad{0};
+    std::atomic<bool> stop{false};
+    std::thread echo([&]() {
+        volatile uint32_t * head = &ctl->head;
+        const float * x = ggml_moe_sc_x(host, MOE_SC_TEST_N, 0);
+        float * rows = ggml_moe_sc_rows(host, MOE_SC_TEST_N, 0);
+        for (int k = 0; k < n && !stop.load(std::memory_order_relaxed); ) {
+            if (__atomic_load_n(head, __ATOMIC_ACQUIRE) != (uint32_t) k + 1) {
+                continue;
+            }
+            for (int i = 0; i < MOE_SC_TEST_N; ++i) {
+                if (x[i] != moe_sc_pattern((uint32_t) k, i, 0x1234u)) {
+                    host_bad.fetch_add(1, std::memory_order_relaxed);
+                }
+                rows[i] = moe_sc_pattern((uint32_t) k, i, 0x9876u);
+            }
+            __atomic_store_n(&ctl->resp[0], (uint32_t) k + 1, __ATOMIC_RELEASE);
+            ++k;
+        }
+    });
+    k_moe_sc_selftest<<<1, 256, 0, stream>>>((ggml_moe_sc_ctl *) host_dev, ggml_moe_sc_x(host_dev, MOE_SC_TEST_N, 0),
+                                             ggml_moe_sc_rows(host_dev, MOE_SC_TEST_N, 0), n, bad);
+    const cudaError_t err = cudaStreamSynchronize(stream);
+    stop.store(true);
+    echo.join();
+    unsigned int dev_bad = 0;
