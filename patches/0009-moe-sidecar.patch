diff --git a/ggml/include/ggml-moe-sidecar.h b/ggml/include/ggml-moe-sidecar.h
new file mode 100644
index 0000000..f4cdf9e
--- /dev/null
+++ b/ggml/include/ggml-moe-sidecar.h
@@ -0,0 +1,82 @@
+#pragma once
+
+// Channel between a decode graph running on the GPU and a CPU thread that
+// computes the experts the GPU cache does not hold (MoE "sidecar").
+//
+// One allocation of mapped pinned host memory holds the control block below
+// followed, per layer, by the layer input (n_embd floats) and the response
+// rows (GGML_MOE_SC_MAX_USED * n_embd floats). A small device allocation holds
+// the sequence counter, which must live in device memory because a captured
+// CUDA graph replays identical kernel arguments every token.
+//
+// Protocol, per layer and token:
+//   GPU  MOE_POST  writes ids (and x if any expert missed), the ring record,
+//                  then head = seq + 1
+//   CPU            reads the record; for a miss computes the rows, then
+//                  writes resp[layer] = seq + 1
+//   GPU  MOE_JOIN  if the layer missed, waits for resp[layer] == seq + 1 and
+//                  adds the missed rows to the cached chain's output
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define GGML_MOE_SC_MAX_LAYERS 128
+#define GGML_MOE_SC_RING       256
+#define GGML_MOE_SC_MAX_USED   16
+#define GGML_MOE_SC_ALIGN      256
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct ggml_moe_sc_record {
+    uint32_t seq;
+    uint32_t layer;
+    uint32_t miss;
+    uint32_t pad;
+};
+
+struct ggml_moe_sc_ctl {
+    uint32_t head;  // GPU writes: records posted so far
+    uint32_t err;   // GPU writes: nonzero after a timed-out wait
+    uint32_t pad[14];
+    struct ggml_moe_sc_record ring[GGML_MOE_SC_RING];
+    uint32_t resp[GGML_MOE_SC_MAX_LAYERS];                        // CPU writes
+    int32_t  ids[GGML_MOE_SC_MAX_LAYERS][GGML_MOE_SC_MAX_USED];  // GPU writes
+};
+
+struct ggml_moe_sc_dev {
+    uint32_t seq;
+    uint32_t posted_seq[GGML_MOE_SC_MAX_LAYERS];
+    uint32_t posted_miss[GGML_MOE_SC_MAX_LAYERS];
+};
+
+static inline size_t ggml_moe_sc_round(size_t n) {
+    return (n + GGML_MOE_SC_ALIGN - 1) / GGML_MOE_SC_ALIGN * GGML_MOE_SC_ALIGN;
+}
+
+static inline size_t ggml_moe_sc_layer_bytes(int n_embd) {
+    return ggml_moe_sc_round((size_t) n_embd * sizeof(float)) +
+           ggml_moe_sc_round((size_t) GGML_MOE_SC_MAX_USED * n_embd * sizeof(float));
+}
+
+static inline size_t ggml_moe_sc_host_bytes(int n_embd) {
+    return ggml_moe_sc_round(sizeof(struct ggml_moe_sc_ctl)) +
+           (size_t) GGML_MOE_SC_MAX_LAYERS * ggml_moe_sc_layer_bytes(n_embd);
+}
+
+// layer input, n_embd floats
+static inline float * ggml_moe_sc_x(void * base, int n_embd, int layer) {
+    return (float *) ((char *) base + ggml_moe_sc_round(sizeof(struct ggml_moe_sc_ctl)) +
+                      (size_t) layer * ggml_moe_sc_layer_bytes(n_embd));
+}
+
+// response rows, GGML_MOE_SC_MAX_USED * n_embd floats; row e is expert slot e of the layer's top-k
+static inline float * ggml_moe_sc_rows(void * base, int n_embd, int layer) {
+    return (float *) ((char *) ggml_moe_sc_x(base, n_embd, layer) +
+                      ggml_moe_sc_round((size_t) n_embd * sizeof(float)));
+}
+
+#ifdef __cplusplus
+}
+#endif
